{
  "name": "@curio/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=../../.env dist/index.js",
    "typecheck": "tsc --noEmit",
    "typecheck:vercel": "node scripts/vercel-typecheck.cjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:watch": "vitest",
    "db:migrate:prod": "DB_TARGET=prod drizzle-kit migrate",
    "vercel-build": "pnpm --filter @curio/shared build"
  },
  "devDependencies": {
    "@inngest/test": "^1.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.4",
    "@types/supertest": "^7.2.1",
    "drizzle-kit": "^0.31.11",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.3.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.0.2"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.82",
    "@aws-sdk/client-s3": "^3.1141.0",
    "@aws-sdk/s3-request-presigner": "^3.1141.0",
    "@clerk/express": "^2.1.72",
    "@curio/shared": "workspace:*",
    "@langfuse/client": "^5.11.1",
    "@langfuse/otel": "^5.11.1",
    "@langfuse/tracing": "^5.11.1",
    "@langfuse/vercel-ai-sdk": "^5.11.1",
    "@neondatabase/serverless": "^1.1.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/sdk-node": "^0.222.0",
    "@upstash/ratelimit": "^2.2.0",
    "@upstash/redis": "^1.39.0",
    "ai": "^7.0.123",
    "cors": "^2.8.6",
    "drizzle-orm": "^0.45.3",
    "express": "^5.2.1",
    "gpt-tokenizer": "^4.0.0",
    "helmet": "^8.3.0",
    "inngest": "^4.21.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "unpdf": "^1.8.1",
    "zod": "^4.6.5"
  }
}
