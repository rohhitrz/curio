{
  "name": "@curio/evals",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "eval": "tsx --env-file-if-exists=../.env scripts/run-eval.ts",
    "eval:paths": "tsx --env-file-if-exists=../.env scripts/run-path-eval.ts",
    "eval:lessons": "tsx --env-file-if-exists=../.env scripts/run-lesson-eval.ts",
    "eval:injection": "tsx --env-file-if-exists=../.env scripts/run-injection-eval.ts",
    "fetch-docs": "tsx --env-file-if-exists=../.env scripts/fetch-documents.ts",
    "preview": "tsx scripts/preview-chunks.ts",
    "check": "tsx scripts/check-dataset.ts",
    "review": "tsx scripts/review-dataset.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.0.2"
  }
}
