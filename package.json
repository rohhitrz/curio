{
  "name": "curio",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build:shared": "pnpm --filter @curio/shared build",
    "dev": "pnpm build:shared && pnpm -r --parallel --if-present dev",
    "dev:inngest": "npx --yes inngest-cli@latest dev --no-discovery -u http://localhost:4000/api/inngest",
    "build": "pnpm -r --if-present build",
    "test": "pnpm build:shared && pnpm -r --if-present test",
    "db:test:up": "docker compose up -d --wait",
    "db:test:down": "docker compose down",
    "typecheck": "pnpm build:shared && pnpm -r --if-present typecheck",
    "lint": "pnpm build:shared && eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "eval": "pnpm build:shared && pnpm --filter @curio/evals eval",
    "eval:paths": "pnpm build:shared && pnpm --filter @curio/evals eval:paths",
    "eval:lessons": "pnpm build:shared && pnpm --filter @curio/evals eval:lessons",
    "eval:injection": "pnpm build:shared && pnpm --filter @curio/evals eval:injection"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1"
  }
}
