{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dev",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000,
      "autoPort": false
    },
    {
      "name": "api",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@curio/server",
        "dev"
      ],
      "port": 4000,
      "autoPort": false
    },
    {
      "name": "web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@curio/web",
        "dev"
      ],
      "port": 3000,
      "autoPort": false
    },
    {
      "name": "inngest",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "run",
        "dev:inngest"
      ],
      "port": 8288,
      "autoPort": false
    }
  ]
}
