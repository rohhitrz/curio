# Copy to .env and fill in. Never commit .env.
# Each phase adds the keys it needs (see docs/05-build-plan.md §15).

# --- Server ---
NODE_ENV=development
PORT=4000
# Comma-separated origins allowed by CORS
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=info

# --- Neon Postgres (Phase 0) ---
# Pooled connection string for the `dev` branch
DATABASE_URL=
# Pooled connection string for the `test` branch (used only by tests)
TEST_DATABASE_URL=

# --- Web (Phase 0) ---
NEXT_PUBLIC_API_URL=http://localhost:4000

# --- Clerk (Phase 1) ---
# Dashboard → Configure → API keys. Publishable key is used by both apps.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
