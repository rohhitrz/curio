# Copy to .env and fill in. Never commit .env.
# Each phase adds the keys it needs (see docs/05-build-plan.md §15).

# --- Server ---
NODE_ENV=development
PORT=4000
# Comma-separated origins allowed by CORS
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=info

# --- Neon Postgres (Phase 0) ---
# Pooled connection string for the `dev` branch
DATABASE_URL=
# Local Postgres in Docker, used only by tests (`pnpm db:test:up`, docker-compose.yml)
TEST_DATABASE_URL=postgres://curio:curio@localhost:5434/curio_test
# Pooled connection string for the `main` branch. Local only, used by
# `pnpm db:migrate:prod`. On Vercel the server reads it as DATABASE_URL.
PROD_DATABASE_URL=

# --- Web (Phase 0) ---
NEXT_PUBLIC_API_URL=http://localhost:4000

# --- Clerk (Phase 1) ---
# Dashboard → Configure → API keys. Publishable key is used by both apps.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# --- Cloudflare R2 (Phase 2) ---
# R2 → Manage API tokens (Object Read & Write). Local uses the curio-dev bucket;
# Vercel's curio-server uses curio-prod. Paste values without quotes.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=curio-dev

# --- Inngest (Phase 3) ---
# app.inngest.com → your app → Manage → Keys. Needed for Vercel (production/preview).
# Locally INNGEST_DEV=1 uses the Inngest dev server instead (`pnpm dev:inngest`, UI on :8288),
# which needs no keys. Leave INNGEST_DEV unset on Vercel: without it both keys are required,
# and the server refuses to start with it when NODE_ENV is production.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
INNGEST_DEV=1
# Production only: this API's origin (e.g. https://curio-server-ten.vercel.app), so an Inngest
# sync always registers it, whatever the request's Host header says. Not a secret.
# INNGEST_SERVE_ORIGIN=

# --- OpenAI (Phase 3) ---
# platform.openai.com → API keys. Used for embeddings (Phase 3) and chat (Phase 5).
OPENAI_API_KEY=

# --- Firecrawl (Phase 3) ---
# firecrawl.dev → Dashboard → API keys. Scrapes website sources to markdown.
FIRECRAWL_API_KEY=

# --- YouTube transcript API (Phase 3) ---
# Supadata (decision I-12): supadata.ai → Dashboard → API keys.
TRANSCRIPT_API_KEY=

# --- Tavily (Phase 8) ---
# tavily.com → Dashboard → API keys. Finds learning-path resources (web search).
TAVILY_API_KEY=

# --- Langfuse (Phase 5) ---
# cloud.langfuse.com → project → Settings → API keys. Traces every chat / pipeline step.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# e.g. https://cloud.langfuse.com (or your region's host)
LANGFUSE_BASE_URL=

# --- Upstash Redis (Phase 5) ---
# console.upstash.com → Redis database → REST API. Rate limits and busy locks.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Cohere (Phase 6) ---
# dashboard.cohere.com → API keys. Rerank; required while the `rerank` flag is on
# (apps/server/src/config/flags.ts). A Trial key allows 10 calls/min.
COHERE_API_KEY=
