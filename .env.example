# Copy to .env and fill in. Never commit .env.
# Each phase adds the keys it needs (see docs/05-build-plan.md §15).

# --- Server ---
NODE_ENV=development
PORT=4000
# Comma-separated origins allowed by CORS
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=info

# --- Neon Postgres (Phase 0) ---
# Pooled connection string for the `dev` branch
DATABASE_URL=
# Pooled connection string for the `test` branch (used only by tests)
TEST_DATABASE_URL=
# Pooled connection string for the `main` branch. Local only, used by
# `pnpm db:migrate:prod`. On Vercel the server reads it as DATABASE_URL.
PROD_DATABASE_URL=

# --- Web (Phase 0) ---
NEXT_PUBLIC_API_URL=http://localhost:4000

# --- Clerk (Phase 1) ---
# Dashboard → Configure → API keys. Publishable key is used by both apps.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# --- Cloudflare R2 (Phase 2) ---
# R2 → Manage API tokens (Object Read & Write). Local uses the curio-dev bucket;
# Vercel's curio-server uses curio-prod. Paste values without quotes.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=curio-dev

# --- Inngest (Phase 3) ---
# app.inngest.com → your app → Manage → Keys. Needed for Vercel (production/preview).
# Locally the Inngest dev server (`npx inngest-cli dev`) needs no keys; INNGEST_DEV=1 uses it.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
INNGEST_DEV=1

# --- OpenAI (Phase 3) ---
# platform.openai.com → API keys. Used for embeddings (Phase 3) and chat (Phase 5).
OPENAI_API_KEY=

# --- Firecrawl (Phase 3) ---
# firecrawl.dev → Dashboard → API keys. Scrapes website sources to markdown.
FIRECRAWL_API_KEY=

# --- YouTube transcript API (Phase 3) ---
# Vendor is decided in step 3.2 (decision I-12, e.g. Supadata → supadata.ai dashboard).
TRANSCRIPT_API_KEY=
